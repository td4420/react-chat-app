// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String          @id @default(uuid())
  email       String          @unique
  name        String
  avatar      String          @default("https://chatscope.io/storybook/react/assets/zoe-E7ZdmXF0.svg")
  publicKey   String          @db.Text
  roomMembers RoomMember[]
  messages    Message[]
  messageKey  MessageKey[]
  recoveryKey     UserRecoveryKey @relation(fields: [recoveryKeyId], references: [id])
  recoveryKeyId   Int             @unique
}

model Room {
  id           String       @id @default(uuid())
  name         String
  avatar       String       @default("https://chatscope.io/storybook/react/assets/zoe-E7ZdmXF0.svg")
  isDirectChat Boolean      @default(false)
  roomMembers  RoomMember[]
  messages     Message[]
}

model RoomMember {
  id       String   @id @default(uuid())
  memberId String
  roomId   String
  joinedAt DateTime @default(now())
  role     UserRole @default(USER)
  member   User     @relation(fields: [memberId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

model Message {
  id               String       @id @default(uuid())
  createdAt        DateTime     @default(now())
  encryptedPayload String       @db.Text
  iv               String       @db.Text
  senderId         String
  sender           User         @relation(fields: [senderId], references: [id])
  roomId           String
  room             Room         @relation(fields: [roomId], references: [id])
  messageKey       MessageKey[]
}

model MessageKey {
  id           String  @id @default(uuid())
  messageId    String
  message      Message @relation(fields: [messageId], references: [id])
  recipientId  String
  recipient    User    @relation(fields: [recipientId], references: [id])
  encryptedKey String  @db.Text
}

model UserRecoveryKey {
  id                  Int   @id @default(autoincrement())
  encryptedPrivateKey Json
  encryptedPassphrase Json
  user                User?
}
